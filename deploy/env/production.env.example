# Workeasy360 - production environment (Phase 12). NAMES ONLY.
#
# The real file is rendered at deploy time from the secret store (AWS Secrets
# Manager / SSM Parameter Store, 1Password, Vault - docs/phase-12/05-secrets-
# and-key-rotation.md) onto the deploy host with mode 0600, passed to compose
# as W360_ENV_FILE **and** as `docker compose --env-file`, and never committed
# (.gitignore: deploy/env/*.env). Compose hands each container only what it
# reads: the edge and the frontend receive no secret, and the api/workers never
# receive POSTGRES_PASSWORD or the owner's password (production.yml).
# Every "<secret>" below is generated per environment, never reused, never
# written into a ticket, a chat, a log or this repository.
#
# Production refuses to start with any required value missing or weak - it
# lists every problem at once (config/settings/production.py).

# --- release and hosts ---------------------------------------------------------
W360_ENVIRONMENT=production
W360_RELEASE=                         # image tag, e.g. 2026.10.01-3f2a9c1
# The five portal hosts (ADR-043, docs/portals/design.md). Each is its own origin
# with host-only cookies; production refuses to start unless all five are set,
# distinct, https and consistent with the three lists below.
W360_ADMIN_ORIGIN=                    # https://admin.workeasy360.com   (Super Admin)
W360_PARTNER_ORIGIN=                  # https://partner.workeasy360.com (Partner portal)
W360_APP_ORIGIN=                      # https://app.workeasy360.com     (Customer portal)
W360_AUTH_ORIGIN=                     # https://auth.workeasy360.com    (central sign-in, OIDC issuer)
W360_API_ORIGIN=                      # https://api.workeasy360.com     (products and providers)
W360_EDGE_UPSTREAM_HOST=              # api.workeasy360.com (the host of W360_API_ORIGIN)
W360_ALLOWED_HOSTS=                   # admin.workeasy360.com,partner.workeasy360.com,app.workeasy360.com,auth.workeasy360.com,api.workeasy360.com
                                      #   never '*' and never a leading dot ('.workeasy360.com')
W360_CSRF_TRUSTED_ORIGINS=            # exactly the four web origins: https://admin.workeasy360.com,
                                      #   https://partner.workeasy360.com,https://app.workeasy360.com,
                                      #   https://auth.workeasy360.com (no wildcard, no product host)
W360_FRONTEND_URL=                    # https://app.workeasy360.com (= W360_APP_ORIGIN)
W360_OIDC_ISSUER=                     # https://auth.workeasy360.com (= W360_AUTH_ORIGIN, no trailing slash)
W360_TRUSTED_PROXY_COUNT=1            # the edge. Behind a CDN: 2, AND list the CDN's
W360_EDGE_TRUSTED_PROXIES=            #   ranges here (space-separated), or every user
                                      #   shares one address (deploy/edge/Caddyfile)
W360_TLS_ISSUER=acme

# --- platform keys (each >= 32 chars, all different) -----------------------------
W360_SECRET_KEY=<secret>              # >= 50 chars
W360_FILE_URL_SIGNING_KEY=<secret>
W360_INTEGRATION_SECRETS_KEYS=<secret>        # comma list, newest first
W360_NOTIFICATION_SEAL_KEYS=<secret>          # comma list, newest first
# OIDC signing keys are read per kid from W360_OIDC_SIGNING_KEY_<KID>
# (config/settings/base.py OIDC_SIGNING_KEY_ENV_PREFIX).

# --- database (PgBouncer for the app, direct for migrations) ---------------------
W360_DB_NAME=workeasy360
W360_DB_HOST=pgbouncer
W360_DB_PORT=6432
W360_DB_DIRECT_HOST=postgres
W360_DB_DIRECT_PORT=5432
W360_DB_APP_USER=w360_app
W360_DB_APP_PASSWORD=<secret>
W360_DB_MIGRATOR_USER=w360_migrator
W360_DB_MIGRATOR_PASSWORD=<secret>
POSTGRES_PASSWORD=<secret>            # superuser; only the postgres container sees it in use

# --- Redis and broker --------------------------------------------------------------
W360_REDIS_PASSWORD=<secret>
W360_REDIS_URL=                       # compose: redis://:<secret>@redis:6379/0 with the flag below;
                                      # managed Redis with TLS: rediss://:<secret>@<host>:6379/0
W360_ALLOW_PLAINTEXT_REDIS=false      # true for the compose topology (private Docker network), as a reviewed decision
RABBITMQ_DEFAULT_USER=w360
RABBITMQ_DEFAULT_PASS=<secret>
W360_BROKER_URL=                      # compose: amqp://w360:<secret>@rabbitmq:5672// with the flag below;
                                      # managed broker with TLS: amqps://w360:<secret>@<host>:5671//
W360_ALLOW_PLAINTEXT_BROKER=false     # true for the compose topology (private Docker network), as a reviewed decision

# --- files (S3) -------------------------------------------------------------------
W360_FILE_STORAGE_BACKEND=s3
W360_S3_BUCKET=
W360_S3_REGION=
W360_S3_SSE=aws:kms
W360_S3_KMS_KEY_ID=
# Credentials: the task/instance role. Otherwise AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY from the secret store - never a W360_ setting.

# --- email (a real transactional provider; SPF/DKIM/DMARC on the sending domain) ---
W360_EMAIL_HOST=
W360_EMAIL_PORT=587
W360_EMAIL_USE_TLS=true
W360_EMAIL_HOST_USER=
W360_EMAIL_HOST_PASSWORD=<secret>
W360_DEFAULT_FROM_EMAIL=              # no-reply@workeasy360.com

# --- payments (hosted checkout only; card data never reaches the platform) -----
# W360_PAYMENT_CREDENTIAL_<REF>=<secret>
# W360_PAYMENT_WEBHOOK_SECRET_<REF>=<secret>

# --- AI providers (optional; AI answers 503 without them) --------------------------
# W360_AI_CREDENTIAL_<REF>=<secret>

# --- observability -----------------------------------------------------------------
W360_LOG_LEVEL=INFO
W360_METRICS_TOKEN=<secret>           # bearer token for /healthz/metrics (scraper only)

# --- one-time Super Admin bootstrap (remove after the first run) --------------------
# PLATFORM_SUPERADMIN_EMAIL=
# PLATFORM_SUPERADMIN_PASSWORD=<secret>
