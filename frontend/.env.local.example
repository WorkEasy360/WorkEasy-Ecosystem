# Copy to .env.local for local development.

# The Django platform API this app proxies /api/* to (next.config.ts).
# Never exposed to the browser - only this Next.js server process reads it.
BACKEND_ORIGIN=http://localhost:8000

# The separate Partner Panel app (Desktop\partner-panel). When set, the sign-in
# chooser's "Partner" option opens it instead of this platform's partner sign-in.
# Runtime, server-side only. Unset = unchanged behaviour.
# W360_PARTNER_PANEL_URL=http://localhost:5180/login
