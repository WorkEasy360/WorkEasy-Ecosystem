# Workeasy360 - local development configuration.
#
# Copy to .env and adjust. .env is git-ignored and must NEVER contain a
# production secret: production values come from the process environment,
# populated by a secret manager (12-security.md section 5).
#
# Every variable below has a safe development default in config/settings/.
# Production *requires* the starred ones and refuses to boot without them.

W360_ENVIRONMENT=development
W360_RELEASE=dev                      # * required in production

# --- Secrets. Development defaults only; production rejects these values.
W360_SECRET_KEY=insecure-development-key-do-not-use          # * >= 50 chars
W360_FILE_URL_SIGNING_KEY=                                   # * >= 32 chars
W360_MFA_ENCRYPTION_KEY=                                     # * >= 32 chars; distinct from SECRET_KEY
# Seals integration signing secrets (Phase 6). Comma-separated: the first seals,
# every key opens, so the key rotates by prepending a new one.
W360_INTEGRATION_SECRETS_KEYS=                               # * each >= 32 chars; distinct from every other key
# Seals one-time values inside queued notifications - an invitation link - so a
# database copy holds no working link (Phase 8 extension). Same rotation rule.
W360_NOTIFICATION_SEAL_KEYS=                                 # * each >= 32 chars; distinct from every other key

# --- Database.
# Two roles (ADR-009): the application connects as a non-owner NOBYPASSRLS
# role, migrations as the owner. The app refuses to start if its role can
# bypass RLS.
W360_DB_NAME=workeasy360
W360_DB_APP_USER=w360_app
W360_DB_APP_PASSWORD=w360_app_pw                             # * >= 16 chars
W360_DB_MIGRATOR_USER=w360_migrator
W360_DB_MIGRATOR_PASSWORD=w360_migrator_pw

# Runtime traffic goes through PgBouncer in transaction mode (parity with
# production - see R-01). Migrations use the direct port, because DDL cannot
# run inside the transaction a pooler would wrap it in.
W360_DB_HOST=127.0.0.1
W360_DB_PORT=6442
W360_DB_DIRECT_HOST=127.0.0.1
W360_DB_DIRECT_PORT=5442

W360_DB_STATEMENT_TIMEOUT_MS=10000
W360_DB_LOCK_TIMEOUT_MS=5000
W360_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
W360_DB_CONN_MAX_AGE=0

# --- Redis. Aggressive timeouts: the timeout, not the outage, is what
# exhausts a worker pool.
W360_REDIS_URL=redis://127.0.0.1:6392/0
W360_REDIS_CONNECT_TIMEOUT_S=0.05
W360_REDIS_OPERATION_TIMEOUT_S=0.1

# --- Broker. Three queue groups: critical, default, heavy (R-12).
W360_BROKER_URL=amqp://w360:w360_pw@127.0.0.1:5682//
W360_BROKER_VISIBILITY_TIMEOUT=3600    # must exceed the longest time_limit (1200 s)
W360_TASK_MAX_RETRIES=5
W360_TASK_SOFT_TIME_LIMIT=60
W360_TASK_TIME_LIMIT=120

# --- Hosts and origins. Never "*" in production.
W360_ALLOWED_HOSTS=localhost,127.0.0.1                       # * required
W360_CSRF_TRUSTED_ORIGINS=http://localhost:8000              # * https only

# --- Trusted proxy topology (D-009). How many hops of infrastructure WE
# control sit in front of this process: 0 = directly exposed (local, CI),
# 1 = one ALB/ingress, 2 = CloudFront in front of an ALB. Every rate limit
# is keyed partly on the caller's address, and both wrong answers fail
# silently - too low and every client behind the proxy shares one bucket,
# too high and the caller names their own. Required in production; it also
# decides whether X-Forwarded-Proto is believed at all.
# Never count the frontend's Next.js server: its /api rewrite appends nothing
# (ALB -> Next.js -> Django is 1), and it must never be the public edge.
# See backend/workeasy360/platform/observability/client_ip.py.
W360_TRUSTED_PROXY_COUNT=0                                   # * required
W360_CLIENT_IP_HEADER=X-Forwarded-For

# --- Rate limits at the platform's own front door (per 60s window).
W360_RL_LOGIN_IP=30                    # per caller address
W360_RL_LOGIN_ACCOUNT=20               # per account; above MAX_FAILED_ATTEMPTS
W360_RL_RESUME=60                      # per caller address

# --- Files. Local storage is refused in production (not durable).
W360_FILE_STORAGE_BACKEND=local                              # * s3
W360_FILE_MAX_BYTES=26214400
W360_FILE_URL_TTL_SECONDS=900

# --- Observability.
W360_LOG_LEVEL=DEBUG
W360_LOG_FORMAT=console                # json in production

# --- Integrations (Phase 6). Outbound webhooks are https-only to public
# addresses; production pins both of these off. Local receivers only.
W360_EGRESS_ALLOW_HTTP=false
W360_EGRESS_ALLOW_LOOPBACK=false

# --- AI, retrieval, analytics (Phase 8). Provider API keys are read per call
# from W360_AI_CREDENTIAL_<REF>, where <REF> is the provider's credential_ref
# upper-cased with '-' as '_' (seeded refs: anthropic, openai). Put them in the
# secret manager, never in this file or the database; without one, AI answers
# 503 and nothing else is affected. Most limits take a W360_AI_* / W360_RAG_* /
# W360_ANALYTICS_* override - see config/settings/base.py and docs/phase-8/.
# W360_AI_CREDENTIAL_ANTHROPIC=
# W360_AI_CREDENTIAL_OPENAI=
# W360_AI_DEFAULT_ORG_MONTHLY_CAP_MICROS=50000000

# --- Payments (Phase 8 extension). Hosted checkout only: card data never
# reaches Workeasy360. A provider row holds *references*; the secrets are read
# per call from W360_PAYMENT_CREDENTIAL_<REF> (Stripe: the secret key;
# Razorpay: key_id:key_secret) and W360_PAYMENT_WEBHOOK_SECRET_<REF>, where
# <REF> is the reference upper-cased with any other character as '_'. Put them
# in the secret manager, never in this file or the database. The provider's
# webhook URL is <API origin>/api/v1/public/payments/webhooks/<provider key>.
# W360_PAYMENT_CREDENTIAL_STRIPE_LIVE=
# W360_PAYMENT_WEBHOOK_SECRET_STRIPE_LIVE=
# The offline test provider (development only; production pins it off):
# W360_PAYMENTS_FAKE_PROVIDER=true
# W360_PAYMENT_GRACE_AFTER_DAYS=7
# W360_PAYMENT_SUSPEND_AFTER_DAYS=21

# --- Phase 9: public site, self-service accounts, pay-first orders ----------
# The public catalog's default currency (the Super Admin can override it in
# Platform settings); a visitor can switch among currencies with prices.
# W360_PUBLIC_CATALOG_CURRENCY=INR
# One-time link lifetimes, and how long an unverified signup is kept.
# W360_ACCOUNT_VERIFY_TTL_HOURS=24
# W360_PASSWORD_RESET_TTL_MINUTES=60
# W360_PENDING_ACCOUNT_TTL_DAYS=7
# How long an unpaid order waits before it expires and its invoice is voided.
# W360_ORDER_TTL_HOURS=24
#
# Platform Super Admin bootstrap (`python manage.py bootstrap_superadmin`).
# Set these in the deployment's SECRET STORE for the one run that creates the
# account - never in this file, the repository, an image or a command line.
# The command never prints the password and never changes an existing
# account's password; re-running it with the same address changes nothing.
# PLATFORM_SUPERADMIN_EMAIL=
# PLATFORM_SUPERADMIN_PASSWORD=
